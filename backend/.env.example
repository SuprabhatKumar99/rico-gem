# RicozKnow Sprint 1 — copy to your deployment environment; never commit real values.
JWT_SECRET=replace-with-a-random-256-bit-or-longer-secret
RAG_EMBEDDING_API_KEY=
RAG_GENERATION_API_KEY=

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
FRONTEND_BASE_URL=http://localhost:4200
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72

# --- Sprint 4 production ---
# Run with SPRING_PROFILES_ACTIVE=prod. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ricozknow
DB_USER=ricozknow_app
DB_PASSWORD=generate-a-unique-secret
REDIS_HOST=redis
REDIS_PORT=6379
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=ricozknow-production
S3_ACCESS_KEY=replace-with-secret-manager-value
S3_SECRET_KEY=replace-with-secret-manager-value
S3_REGION=us-east-1
JWT_SECRET=generate-at-least-32-random-characters
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-secret-manager-value
MAIL_PASSWORD=replace-with-secret-manager-value
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
FRONTEND_BASE_URL=https://app.example.com
TENANT_BASE_DOMAIN=app.example.com
RAG_ENABLED=false
# For hosted AI providers, inject AI_*_API_KEY values via a secret manager. Ollama does not require API keys.
MANAGEMENT_PORT=8081
ALLOWED_ORIGINS=https://app.example.com
# Secret-manager rule: values above are examples only. Inject real secrets at runtime;
# never commit .env.production, cloud credentials, database passwords, JWT secrets, or AI keys.

# Provider-neutral AI configuration
# Generation providers: openai-compatible | openai | huggingface | custom | ollama
AI_GENERATION_PROVIDER=openai-compatible
AI_GENERATION_URL=https://api.openai.com/v1/chat/completions
AI_GENERATION_API_KEY=
AI_GENERATION_MODEL=gpt-4o-mini
AI_GENERATION_INPUT_COST_PER_1K=0.00015
AI_GENERATION_OUTPUT_COST_PER_1K=0.00060

# Embedding providers: openai-compatible | openai | huggingface | custom | ollama
AI_EMBEDDING_PROVIDER=openai-compatible
AI_EMBEDDING_URL=https://api.openai.com/v1/embeddings
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_COST_PER_1K=0.00002

# Native local Ollama endpoints
OLLAMA_GENERATION_URL=http://localhost:11434/api/chat
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings

# Example Hugging Face OpenAI-compatible setup:
# AI_GENERATION_PROVIDER=huggingface
# AI_GENERATION_URL=https://router.huggingface.co/v1/chat/completions
# AI_GENERATION_API_KEY=hf_...
# AI_GENERATION_MODEL=meta-llama/Llama-3.1-8B-Instruct
# For embeddings, use a Hugging Face/OpenAI-compatible embedding endpoint and set its actual vector dimension.

# Example local Ollama setup:
# AI_GENERATION_PROVIDER=ollama
# AI_GENERATION_MODEL=llama3.2
# AI_EMBEDDING_PROVIDER=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_EMBEDDING_DIMENSION=768

# Public backend origin used as the SAML Service Provider base URL.
# For local IdPs this can remain http://localhost:8080; for an external IdP use
# a reachable HTTPS origin/reverse-proxy URL.
SAML_BASE_URL=http://localhost:8080

# === Phase 0 V3: security (set via secret manager in production) ===
# Supply one or more 32-byte AES-256 keys as Base64, tagged with nonsecret key IDs.
# To generate a key locally: openssl rand -base64 32
# RICOZ_SECRET_KEYS=k2026=<base64-key>,k2025=<previous-base64-key>
# RICOZ_SECRET_ACTIVE_KEY=k2026
# Never remove a retired key until every tenant's MFA and OIDC secrets have been rotated.
MFA_MAX_ATTEMPTS=5
MFA_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30

# === Phase 0 V4: credentialed browser request origin policy ===
# Strict comma-separated EXACT origins, without wildcard or trailing slash.
# Must include every trusted frontend origin that calls /api/v1/auth/refresh
# or /api/v1/auth/logout with the HttpOnly refresh-token cookie.
# Local cross-site development example: http://wiki.ricozknow.com:4200
# RICOZ_COOKIE_TRUSTED_ORIGINS=http://wiki.ricozknow.com:4200
RICOZ_COOKIE_TRUSTED_ORIGINS=https://app.example.com

# === Phase 0 V5: Customer-portal authentication hardening ===
# Local HTTP testing can use false/Lax. Production MUST use HTTPS with secure=true.
# For genuinely cross-site browser cookie use, SameSite=None also requires Secure=true.
# Prefer same-site HTTPS proxying; an HTTP backend on localhost will not support
# a cross-site Secure cookie when called from the wiki.ricozknow.com frontend.
RICOZ_CUSTOMER_COOKIE_SECURE=false
RICOZ_CUSTOMER_COOKIE_SAMESITE=Lax
# Ensure RICOZ_COOKIE_TRUSTED_ORIGINS includes each frontend origin that
# POSTs to customer auth /consume and /logout.

# === Phase 0 completion pass ===
# Append-only audit protection is installed by Flyway V28. Retention deletion is
# intentionally OFF unless a reviewed organization policy enables it.
# When enabled, deletes older than max(365, tenant_settings.retention_days)
# are documented in immutable audit_retention_receipts. Keep offline/WORM backups.
RICOZKNOW_AUDIT_RETENTION_ENABLED=false
# RICOZKNOW_RETENTION_CRON=0 30 2 * * *
# Two distinct tenant administrators with enabled MFA are required for
# /api/v1/admin/mfa-recovery. Verify identity through your helpdesk process.
# RICOZ_COOKIE_TRUSTED_ORIGINS also applies to saved-search POST and DELETE.

# Phase 1 governance and publishing
RICOZKNOW_ARTICLE_REQUIRE_INDEPENDENT_REVIEW=true
RICOZKNOW_ARTICLE_SCHEDULE_CHECK_MS=30000
# Optional scheduling overrides: quote cron strings in your deployment environment
RICOZKNOW_ARTICLE_GOVERNANCE_CRON="0 15 3 * * *"
RICOZKNOW_ARTICLE_EXPIRY_CRON="0 0 3 * * *"

# === Phase 2 external connector marketplace ===
# Same tenant URL reachable by providers over HTTPS. Must be a dedicated public backend URL in production.
RICOZ_CONNECTOR_CALLBACK_BASE=https://api.example.com
RICOZ_CONNECTOR_FRONTEND_URL=https://app.example.com
# Generate with `openssl rand -base64 32` and store in a managed secrets system.
# Do not rotate without migrating existing encrypted connector tokens.
RICOZ_CONNECTOR_ENCRYPTION_KEY=
RICOZ_CONNECTOR_SCHEDULER_MS=60000
RICOZ_CONNECTOR_GOOGLE_CLIENT_ID=
RICOZ_CONNECTOR_GOOGLE_CLIENT_SECRET=
RICOZ_CONNECTOR_NOTION_CLIENT_ID=
RICOZ_CONNECTOR_NOTION_CLIENT_SECRET=
RICOZ_CONNECTOR_CONFLUENCE_CLIENT_ID=
RICOZ_CONNECTOR_CONFLUENCE_CLIENT_SECRET=
RICOZ_CONNECTOR_SHAREPOINT_CLIENT_ID=
RICOZ_CONNECTOR_SHAREPOINT_CLIENT_SECRET=
RICOZ_CONNECTOR_SLACK_CLIENT_ID=
RICOZ_CONNECTOR_SLACK_CLIENT_SECRET=
RICOZ_CONNECTOR_SLACK_SIGNING_SECRET=
RICOZ_CONNECTOR_GITHUB_CLIENT_ID=
RICOZ_CONNECTOR_GITHUB_CLIENT_SECRET=
RICOZ_CONNECTOR_GITHUB_WEBHOOK_SECRET=
RICOZ_CONNECTOR_JIRA_CLIENT_ID=
RICOZ_CONNECTOR_JIRA_CLIENT_SECRET=
# See PHASE2_CONNECTOR_MARKETPLACE.md for provider callback registration and scopes.

# Phase 4: Hocuspocus Node process. Use a 32+ byte secret from your secrets manager.
RICOZ_COLLAB_INTERNAL_SECRET=
RICOZ_COLLAB_WS_URL=ws://localhost:1234
RICOZ_COLLAB_API_BASE=http://localhost:8080
RICOZ_COLLAB_REDIS_HOST=localhost
RICOZ_COLLAB_REDIS_PORT=6379

# Phase 5: AI tenant quotas and optional pricing; failover providers are explicit
RICOZ_AI_MONTHLY_REQUEST_LIMIT=2000
RICOZ_AI_FAILOVER_PROVIDERS=
RICOZ_AI_INPUT_USD_PER_1K=0
RICOZ_AI_OUTPUT_USD_PER_1K=0

# Phase 6 automation and support. Set after Flyway V35 is applied.
RICOZ_AUTOMATION_WORKER_DELAY_MS=15000
RICOZ_AUTOMATION_TRIGGER_DELAY_MS=60000
RICOZ_SUPPORT_ESCALATION_HOURS=24
RICOZ_SUPPORT_ESCALATION_SCAN_MS=3600000
# Encrypt new Zendesk / Freshdesk API tokens with the existing RICOZ_SECRET_KEYS key ring.

# Phase 7 SaaS billing. NEVER commit a live secret. Stripe keys must come from a secret manager.
RICOZ_STRIPE_SECRET_KEY=
RICOZ_STRIPE_WEBHOOK_SECRET=
# Public HTTPS SPA URL; must not accept user-controlled redirects.
RICOZ_BILLING_RETURN_URL=https://wiki.ricozknow.com/billing
# Exact operator principal pairs UUID:verified_email, comma-delimited. Empty disables platform access.
RICOZ_PLATFORM_OPERATOR_PRINCIPALS=
# Configure real recurring Stripe Price IDs in the restricted Platform Operations UI.
# Stripe Billing Portal must be configured in Stripe Dashboard.

# Phase 8 MCP (disabled until configured)
RICOZ_MCP_ENABLED=false
RICOZ_MCP_WRITES_ENABLED=false
RICOZ_MCP_RPM=60
RICOZ_MCP_ALLOWED_ORIGINS=

# Social login (distinct from Google Drive / SharePoint connector credentials)
# Public callback base MUST be the browser-reachable backend origin, with no path.
RICOZ_SOCIAL_CALLBACK_BASE_URL=http://localhost:8080
RICOZ_SOCIAL_GOOGLE_CLIENT_ID=
RICOZ_SOCIAL_GOOGLE_CLIENT_SECRET=
RICOZ_SOCIAL_MICROSOFT_CLIENT_ID=
RICOZ_SOCIAL_MICROSOFT_CLIENT_SECRET=
# FRONTEND_BASE_URL must be an actual origin, NOT an origin containing '*' or a wildcard hostname.
# For local setup: FRONTEND_BASE_URL=http://wiki.ricozknow.com:4200
